Cell[BoxData[{
 RowBox[{
  RowBox[{
  "The", " ", "Shear", " ", "force", " ", "is", " ", "a", " ", "piecewise", 
   " ", "function", " ", "which", " ", "is", " ", "represented", " ", "as", 
   " ", "following"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"for", " ", "x"}], " ", "<", " ", "d"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"v", "[", "x_", "]"}], ":=", " ", 
   RowBox[{
    RowBox[{"-", "P"}], " ", "-", " ", 
    FractionBox[
     RowBox[{"wo", "*", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"L", "-", "x"}], ")"}], "2"]}], 
     RowBox[{"2", "*", "L"}]]}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"for", " ", "x"}], " ", ">", " ", "d"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"v", "[", "x_", "]"}], ":=", " ", 
  RowBox[{"-", 
   FractionBox[
    RowBox[{"wo", "*", 
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{"L", "-", "x"}], ")"}], "2"]}], 
    RowBox[{"2", "*", "L"}]]}]}]}], "Code",
 CellChangeTimes->{{3.952164606021047*^9, 3.952164621306734*^9}, {
  3.952165710769835*^9, 3.952165711192164*^9}},
 CellLabel->
  "In[691]:=",ExpressionUUID->"87de2a22-4c97-4292-9853-66ae1fc89e92"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Ploting", " ", "the", " ", "shear", " ", "force", " ", "diagram"}],
   ";"}], "\n", 
 RowBox[{
  RowBox[{"L1", " ", "=", " ", "L"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"v", "[", "x_", "]"}], " ", ":=", " ", 
  RowBox[{"Piecewise", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "P"}], " ", "-", " ", 
        FractionBox[
         RowBox[{"wo", "*", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"L", "-", "x"}], ")"}], "2"]}], 
         RowBox[{"2", "*", "L"}]]}], ",", " ", 
       RowBox[{"x", " ", "<", " ", "d"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        FractionBox[
         RowBox[{"wo", "*", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"L", "-", "x"}], ")"}], "2"]}], 
         RowBox[{"2", "*", "L"}]]}], ",", " ", 
       RowBox[{"x", " ", ">", " ", "d"}]}], "}"}]}], "}"}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"Graph1", " ", "=", " ", 
   RowBox[{"Manipulate", "[", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"v", "[", "x", "]"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", "0", ",", " ", "L"}], "}"}], ",", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"Red", ",", "Thick", ",", 
          RowBox[{"Thickness", "[", "0.005", "]"}]}], "}"}]}], ",", "\n", 
       "\t", 
       RowBox[{"PlotRange", " ", "->", " ", "All"}], ",", " ", 
       RowBox[{"AxesLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{"\"\<x\>\"", ",", " ", "\"\<v(x)\>\""}], "}"}]}], ",", "\n", 
       "\t", 
       RowBox[{"PlotLabel", " ", "->", " ", 
        RowBox[{"Style", "[", 
         RowBox[{
         "\"\<Shear Force Diagram\>\"", ",", " ", "20", ",", " ", "Bold", ",",
           "Italic"}], "]"}]}], ",", " ", 
       RowBox[{"GridLines", "\[Rule]", "Automatic"}], ",", "\n", "\t", 
       RowBox[{"Frame", "\[Rule]", "True"}], ",", "\n", "\t", 
       RowBox[{"FrameLabel", " ", "->", " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"\"\<x (m)\>\"", ",", " ", "20", ",", "Italic"}], "]"}], 
          ",", " ", 
          RowBox[{"Style", "[", 
           RowBox[{
           "\"\<Shear Force (N)\>\"", ",", " ", "15", ",", " ", "Italic"}], 
           "]"}]}], "}"}]}], ",", "\n", "\t", 
       RowBox[{"PlotTheme", "->", "\"\<Classic\>\""}], ",", " ", 
       RowBox[{"ImageSize", "\[Rule]", "510"}], ",", " ", 
       RowBox[{"Filling", "\[Rule]", "Top"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"L", ",", "5", ",", "L1"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Graph1", "\t"}]}], "Code",
